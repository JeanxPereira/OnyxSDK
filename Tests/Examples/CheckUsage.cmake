# Runs an executable with no arguments and requires exit code 1 and a usage naming probe and render.
if(NOT EXE)
    message(FATAL_ERROR "CheckUsage.cmake needs -DEXE=<path>")
endif()
execute_process(COMMAND "${EXE}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 1)
    message(FATAL_ERROR "${EXE} exited with ${code}, expected 1\n${out}${err}")
endif()
set(text "${out}${err}")
foreach(verb probe render)
    if(NOT text MATCHES "${verb}")
        message(FATAL_ERROR "${EXE} did not name '${verb}' in its usage:\n${text}")
    endif()
endforeach()
