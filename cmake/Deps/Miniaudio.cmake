function(onyx_dep_miniaudio)
    if(TARGET Onyx_miniaudio)
        return()
    endif()
    add_library(Onyx_miniaudio STATIC "${PROJECT_SOURCE_DIR}/third_party/miniaudio/miniaudio.c")
    add_library(miniaudio::miniaudio ALIAS Onyx_miniaudio)
    target_include_directories(Onyx_miniaudio PUBLIC "${PROJECT_SOURCE_DIR}/third_party/miniaudio")
    target_compile_definitions(Onyx_miniaudio PRIVATE
        MA_NO_ENCODING MA_NO_DECODING MA_NO_GENERATION MA_NO_RESOURCE_MANAGER MA_NO_NODE_GRAPH)
    if(MSVC)
        target_compile_options(Onyx_miniaudio PRIVATE /W0)
    else()
        target_compile_options(Onyx_miniaudio PRIVATE -w)
        find_package(Threads REQUIRED)
        target_link_libraries(Onyx_miniaudio PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
    endif()
endfunction()
