# Reads a compiled .spv file and writes a header holding its words.
# Run through `cmake -P` from onyx_add_spirv with:
#   INPUT_SPV     the compiled .spv file
#   OUTPUT_HEADER the header to write
#   SYMBOL        PascalCase stem, e.g. SceneVert -> kSceneVert, kSceneVertWords

if(NOT DEFINED INPUT_SPV OR NOT DEFINED OUTPUT_HEADER OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR
        "GenerateSpirvHeader.cmake requires -DINPUT_SPV=... -DOUTPUT_HEADER=... -DSYMBOL=...")
endif()

file(READ "${INPUT_SPV}" _hex HEX)
string(LENGTH "${_hex}" _hexLen)
math(EXPR _byteCount "${_hexLen} / 2")
if(NOT _byteCount GREATER 0)
    message(FATAL_ERROR "${INPUT_SPV} is empty")
endif()
math(EXPR _remainder "${_byteCount} % 4")
if(NOT _remainder EQUAL 0)
    message(FATAL_ERROR "${INPUT_SPV} size ${_byteCount} is not a multiple of 4")
endif()
math(EXPR _wordCount "${_byteCount} / 4")

# SPIR-V words are little-endian: file(READ HEX) yields bytes in file order,
# so each word's four byte pairs are reversed into one literal.
set(_body "")
set(_i 0)
while(_i LESS _wordCount)
    math(EXPR _off "${_i} * 8")
    string(SUBSTRING "${_hex}" ${_off} 2 _b0)
    math(EXPR _o1 "${_off} + 2")
    string(SUBSTRING "${_hex}" ${_o1} 2 _b1)
    math(EXPR _o2 "${_off} + 4")
    string(SUBSTRING "${_hex}" ${_o2} 2 _b2)
    math(EXPR _o3 "${_off} + 6")
    string(SUBSTRING "${_hex}" ${_o3} 2 _b3)
    string(APPEND _body "0x${_b3}${_b2}${_b1}${_b0}u,")
    math(EXPR _i "${_i} + 1")
    math(EXPR _col "${_i} % 8")
    if(_col EQUAL 0 AND _i LESS _wordCount)
        string(APPEND _body "\n    ")
    endif()
endwhile()

file(WRITE "${OUTPUT_HEADER}" "// Generated by cmake/GenerateSpirvHeader.cmake. Do not edit.
#pragma once

#include <cstddef>
#include <cstdint>

namespace Onyx::Spirv {

inline constexpr std::uint32_t k${SYMBOL}[] = {
    ${_body}
};
inline constexpr std::size_t k${SYMBOL}Words = ${_wordCount};

}
")
